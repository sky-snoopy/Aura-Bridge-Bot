# ---------- Minecraft ----------
# Microsoft account email of the bot account (first start prints a login code to enter in the browser)
MC_EMAIL=
MC_HOST=

# ---------- Discord ----------
DISCORD_TOKEN=
# Channel where chat is bridged both ways (Discord <-> guild chat)
BRIDGE_CHANNEL_ID=
# Channel for join/leave/kick notices (optional, defaults to BRIDGE_CHANNEL_ID)
EVENTS_CHANNEL_ID=
# Post Minecraft messages as images (true) or plain text (false)
USE_IMAGES=true

# ---------- Guild ----------
DISCORD_INVITE=https://discord.gg/abc
# {player} and {discord} are replaced
WELCOME_MESSAGE=Welcome to the guild, {player}! Join our Discord: {discord}

# ---------- APIs ----------
# Hypixel key (developer.hypixel.net) - used for !bw, !sd and !gexp
HYPIXEL_API_KEY=

# Urchin - used for !sd tags and !daily, !weekly, !monthly (get a key with /dashboard in the Urchin Discord)
URCHIN_API_KEY=
URCHIN_BASE_URL=https://api.urchin.gg
URCHIN_AUTH_HEADER=x-api-key
URCHIN_TAGS_PATH=/v3/player/tags?player={player}
URCHIN_SESSION_PATH=/v3/player/session?player={player}&duration={duration}
# Set to true to print raw Urchin responses to the console
DEBUG_API=false

# ---------- Behaviour ----------
COMMAND_COOLDOWN_MS=3000
# Delay between messages the bot sends in game (Hypixel rate-limits fast senders)
CHAT_DELAY_MS=900

# ---------- Verification ----------
# Channel where `!setupverify` posts the Verify panel (optional, defaults to the channel you type it in)
VERIFY_CHANNEL_ID=
# Role given after a successful verify (optional)
VERIFIED_ROLE_ID=
# Shown in the panel title: "Welcome to <name>!"
VERIFY_GUILD_NAME=
# Banner image for the panel (optional)
VERIFY_IMAGE_URL=
